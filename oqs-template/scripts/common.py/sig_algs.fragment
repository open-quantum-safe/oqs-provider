
    # post-quantum signatures
    {% for sig in config['sigs'] %}
        {%- for variant in sig['variants'] -%}
            {%- if 'enable_tls' in variant and variant['enable_tls'] -%}
                '{{ variant['name'] }}',
            {%- endif -%}
        {%- endfor -%} 
    {%- endfor %}
    # post-quantum + classical signatures
    {% for sig in config['sigs'] -%}
        {%- for variant in sig['variants'] -%}
            {%- if 'enable_tls' in variant and variant['enable_tls'] -%}
                
            {%- endif -%}
    {%- endfor %} {%- endfor %}
    
